# The Film Location CRM — environment variables
# Copy to .env.local for local development. Never commit real secrets.

# Optional: base URL for API when a backend is connected
# VITE_API_URL=https://api.example.com

# Optional: server-side mailing provider (Resend / SendGrid / Postmark).
# Keep provider credentials in a server/API environment, never VITE_*.
# MAILING_PROVIDER=resend
# MAILING_API_KEY=

# Optional: accounting connector (Xero)
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# Optional: AI extraction provider
# AI_PROVIDER=
# AI_API_KEY=

# ---- Server sign-in and database (v111) — set these in Vercel > Settings > Environment Variables ----
# At least 32 random characters. Changing it signs everyone out.
# TFL_SESSION_SECRET=
# JSON list of accounts. Make each hash with:  node tools/hash-password.mjs "the password"
# TFL_USERS=[{"email":"roni@example.com","name":"Roni","role":"administrator","passwordHash":"scrypt$..."}]
# Database: add "Upstash for Redis" from the Vercel Marketplace; it fills these in for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Browser build only: switch the built-in demo login off once real accounts exist.
# VITE_DEMO_LOGIN=off
